#!/usr/bin/env python3
"""Test double for libsecret's secret-tool: stores secrets in a JSON file
named by $FAKE_KEYRING (required). FAKE_KEYRING_FAIL=1 makes every call
fail like a locked or missing keyring. Records argv to $FAKE_KEYRING.argv
so tests can prove secrets never appear on the command line."""
import json, os, sys
path = os.environ["FAKE_KEYRING"]
with open(path + ".argv", "a") as f:
    f.write(json.dumps(sys.argv[1:]) + "\n")
if os.environ.get("FAKE_KEYRING_FAIL") == "1":
    print("Cannot create an item in a locked collection", file=sys.stderr)
    sys.exit(1)
try:
    db = json.load(open(path))
except (OSError, ValueError):
    db = {}
cmd, rest = sys.argv[1], sys.argv[2:]
if cmd == "store":
    rest = [a for a in rest if not a.startswith("--label")]
    key = json.dumps(rest)
    db[key] = sys.stdin.read()
    json.dump(db, open(path, "w"))
elif cmd == "lookup":
    key = json.dumps(rest)
    if key not in db:
        sys.exit(1)
    sys.stdout.write(db[key])
elif cmd == "clear":
    db.pop(json.dumps(rest), None)
    json.dump(db, open(path, "w"))
else:
    sys.exit(2)
