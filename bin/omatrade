#!/usr/bin/env -S python3 -I
"""omatrade — Questflow on the Omarchy desktop.

Three lists, in the order you reach for them: your TradingView watchlist, the
trading news behind it, and your positions across the accounts connected to
Questflow. The JSON from `omatrade summary --json` is the contract the bar
plugin reads.

Watchlist quotes and news are live, from TradingView's public endpoints.
Positions are demo data until Questflow sign-in ships.
"""

import argparse
import concurrent.futures
import hashlib
import json
import math
import os
import random
import re
import shutil
import subprocess
import sys
import time
import tomllib
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

APP = "omatrade"
PLUGIN_ID = "questflow.omatrade"
QUESTFLOW_URL = os.environ.get("OMATRADE_QUESTFLOW_URL", "https://questflow.ai")
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / APP
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / APP
THEME_DIR = Path.home() / ".local/state/omarchy/current/theme"
ICON = Path(__file__).resolve().parent.parent / "assets" / "omatrade.svg"

TV_WATCHLIST = CONFIG_DIR / "tradingview.txt"
TV_ORIGIN = "https://www.tradingview.com"
TV_SCAN_URL = "https://scanner.tradingview.com/global/scan"
TV_SEARCH_URL = "https://symbol-search.tradingview.com/symbol_search/v3/"
TV_NEWS_URL = "https://news-headlines.tradingview.com/v2/headlines"
TV_CHART_URL = TV_ORIGIN + "/chart/?symbol="
TV_QUOTE_TTL_SEC = 45
TV_NEWS_TTL_SEC = 5 * 60
# News is fetched per symbol, so a long watchlist would be a long wait. The
# first few are the ones you put at the top for a reason.
NEWS_SYMBOLS = 12
NEWS_ITEMS = 30
# TradingView marks breaking stories urgency 1; those, and only those, are
# worth interrupting someone for.
NEWS_NOTIFY_URGENCY = 1


# ── HTTP ─────────────────────────────────────────────────────────────────────

def http_json(url, body=None, timeout=6):
    headers = {"Origin": TV_ORIGIN, "User-Agent": "omatrade/0.3.0"}
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, headers=headers)
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.load(response)


def reason(e):
    return str(getattr(e, "reason", e))


# ── State ────────────────────────────────────────────────────────────────────

def load_json(path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def save_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(value))
    tmp.replace(path)


def load_state():
    return load_json(STATE_DIR / "state.json", {})


def save_state(state):
    save_json(STATE_DIR / "state.json", state)


# ── TradingView watchlist ────────────────────────────────────────────────────
#
# TradingView has no OAuth for third parties and no watchlist API; reading a
# logged-in list would take the browser's session cookie, which this never
# touches. So the list is ours, kept in TradingView's own export format
# (`EXCHANGE:SYMBOL` separated by commas, `###Name` opening a section), and
# can be seeded from a TradingView export or edited symbol by symbol.

# What a TradingView symbol can look like: NASDAQ:BRK.B, CME_MINI:NQ1!,
# BINANCE:BTCUSDT.P. Anything else is not written to the list.
SYMBOL_RE = re.compile(r"^[A-Z0-9_]+:[A-Z0-9_.!&/-]+$")

TV_STARTER = """###Stocks,NASDAQ:NVDA,NASDAQ:TSLA,NASDAQ:QQQ,NASDAQ:COIN,AMEX:SPY,
###Crypto,BINANCE:BTCUSDT,BINANCE:ETHUSDT,KUCOIN:HYPEUSDT,
###Macro,TVC:DXY,CME_MINI:NQ1!"""


def parse_tv_list(text):
    sections, current, seen = [], None, set()
    for token in text.replace("\n", ",").split(","):
        token = token.strip()
        if not token:
            continue
        if token.startswith("###"):
            current = {"name": token[3:].strip() or "Watchlist", "symbols": []}
            sections.append(current)
            continue
        if not SYMBOL_RE.match(token.upper()) or token.upper() in seen:
            continue
        if current is None:
            current = {"name": "", "symbols": []}
            sections.append(current)
        seen.add(token.upper())
        current["symbols"].append(token.upper())
    return [sec for sec in sections if sec["symbols"]]


def format_tv_list(sections):
    parts = []
    for sec in sections:
        if sec["name"]:
            parts.append("###" + sec["name"])
        parts.extend(sec["symbols"])
    return ",".join(parts) + "\n"


def tv_sections():
    try:
        return parse_tv_list(TV_WATCHLIST.read_text()), "file"
    except OSError:
        return parse_tv_list(TV_STARTER), "starter"


def tv_symbols():
    return [sym for sec in tv_sections()[0] for sym in sec["symbols"]]


def write_tv_list(sections):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    TV_WATCHLIST.write_text(format_tv_list(sections))


def tv_quotes(symbols):
    """Quotes by symbol, from cache when fresh, stale cache when offline."""
    cache_path = STATE_DIR / "tv-quotes.json"
    cache = load_json(cache_path, {})
    have = cache.get("quotes", {})
    known = set(have) | set(cache.get("missing", []))
    if cache.get("at", 0) > time.time() - TV_QUOTE_TTL_SEC and known >= set(symbols):
        return have, ""
    try:
        rows = http_json(TV_SCAN_URL, {
            "symbols": {"tickers": symbols},
            "columns": ["close", "change", "change_abs", "description", "currency", "type"],
        }).get("data", [])
    except (OSError, ValueError) as e:
        return have, f"TradingView unreachable ({reason(e)}), showing last quotes"
    quotes = {}
    for row in rows:
        close, pct, change, name, currency, kind = (row.get("d") or [None] * 6)[:6]
        quotes[row["s"].upper()] = {"last": close, "changePct": pct, "change": change,
                                    "name": name, "currency": currency, "type": kind}
    save_json(cache_path, {"at": time.time(), "quotes": quotes,
                           "missing": [s for s in symbols if s not in quotes]})
    return quotes, ""


def tv_url(symbol):
    return TV_CHART_URL + urllib.parse.quote(symbol, safe="")


def tradingview_watchlist():
    sections, source = tv_sections()
    symbols = [sym for sec in sections for sym in sec["symbols"]]
    quotes, error = tv_quotes(symbols) if symbols else ({}, "")
    out = []
    for sec in sections:
        entries = []
        for sym in sec["symbols"]:
            q = quotes.get(sym, {})
            exchange, _, ticker = sym.partition(":")
            entries.append({
                "symbol": sym,
                "display": ticker,
                "exchange": exchange,
                "name": q.get("name") or "",
                "last": q.get("last"),
                "change": q.get("change"),
                "changePct": q.get("changePct"),
                "currency": q.get("currency") or "",
                "found": bool(q),
                "url": tv_url(sym),
            })
        out.append({"name": sec["name"], "entries": entries})
    return {"source": source, "path": str(TV_WATCHLIST), "sections": out, "error": error}


def tv_search(text, limit=8):
    query = urllib.parse.urlencode({
        "text": text, "hl": 0, "exchange": "", "lang": "en",
        "search_type": "undefined", "domain": "production", "sort_by_country": "US",
    })
    rows = http_json(f"{TV_SEARCH_URL}?{query}").get("symbols", [])
    out, seen = [], set()
    for row in rows:
        exchange = row.get("prefix") or row.get("exchange") or ""
        ticker = row.get("symbol", "")
        # Bonds swamp a company search and nobody watches them from a bar.
        if not exchange or not ticker or row.get("type") == "bond":
            continue
        full = f"{exchange}:{ticker}".upper()
        if full in seen or not SYMBOL_RE.match(full):
            continue
        seen.add(full)
        out.append({
            "symbol": full,
            "display": ticker,
            "exchange": exchange,
            "name": row.get("description", ""),
            "type": row.get("type", ""),
        })
        if len(out) >= limit:
            break
    return out


def newest_tv_export():
    """The newest file in ~/Downloads that reads as a TradingView export."""
    downloads = Path(os.environ.get("XDG_DOWNLOAD_DIR", Path.home() / "Downloads"))
    candidates = sorted(downloads.glob("*.txt"), key=lambda f: f.stat().st_mtime, reverse=True)
    for f in candidates[:20]:
        try:
            if f.stat().st_size < 200_000 and parse_tv_list(f.read_text(errors="ignore")):
                return f
        except OSError:
            continue
    return None


def tv_import(path):
    source = Path(path).expanduser() if path else newest_tv_export()
    if not source:
        raise SystemExit("no TradingView export found in ~/Downloads — "
                         "in TradingView: Watchlist menu → Export list…, then run this again")
    sections = parse_tv_list(source.read_text(errors="ignore"))
    if not sections:
        raise SystemExit(f"{source} has no EXCHANGE:SYMBOL entries")
    write_tv_list(sections)
    return source, sections


def tv_add(symbol, section=None):
    sym = symbol.upper()
    if not SYMBOL_RE.match(sym):
        raise SystemExit("use EXCHANGE:SYMBOL, as TradingView writes it (e.g. NASDAQ:AAPL)")
    sections, _ = tv_sections()
    if any(sym in sec["symbols"] for sec in sections):
        return sections
    target = next((sec for sec in sections if section and sec["name"].lower() == section.lower()), None)
    if target is None and section:
        target = {"name": section, "symbols": []}
        sections.append(target)
    if target is None:
        # Something added by hand is something wanted now: the top of the list.
        if not sections:
            sections.append({"name": "", "symbols": []})
        target = sections[0]
    target["symbols"].insert(0, sym)
    write_tv_list(sections)
    return sections


def tv_remove(symbol):
    sym = symbol.upper()
    sections, _ = tv_sections()
    for sec in sections:
        sec["symbols"] = [x for x in sec["symbols"] if x != sym and x.split(":")[-1] != sym]
    sections = [sec for sec in sections if sec["symbols"]]
    write_tv_list(sections)
    return sections


def tv_move(symbol, before=None, after=None, section=None):
    """Move a symbol next to another one, or to the top of a section. Moving
    next to a symbol in another section moves it into that section."""
    sym = symbol.upper()
    anchor = (before or after or "").upper()
    sections, _ = tv_sections()
    if not any(sym in sec["symbols"] for sec in sections):
        raise SystemExit(f"{sym} is not on the watchlist")
    for sec in sections:
        if sym in sec["symbols"]:
            sec["symbols"].remove(sym)
    placed = False
    if anchor:
        for sec in sections:
            if anchor in sec["symbols"]:
                at = sec["symbols"].index(anchor) + (1 if after else 0)
                sec["symbols"].insert(at, sym)
                placed = True
                break
    elif section is not None:
        target = next((sec for sec in sections if sec["name"].lower() == section.lower()), None)
        if target is not None:
            target["symbols"].insert(0, sym)
            placed = True
    if not placed:
        raise SystemExit("nowhere to move it: give --before/--after a symbol on the list, or a --section")
    write_tv_list(sections)
    return sections


# ── News ─────────────────────────────────────────────────────────────────────
#
# Trading news for what you watch: TradingView's headlines for each symbol on
# the watchlist, merged, newest first. Stands in for Questflow signals until
# the signal API exists.

def safe_url(url):
    """Only https links leave this program: a story link comes from a third
    party, and xdg-open would hand any other scheme to whatever handles it."""
    if isinstance(url, str) and urllib.parse.urlsplit(url).scheme == "https":
        return url
    return TV_ORIGIN + "/news/"


def fetch_headlines(symbol):
    query = urllib.parse.urlencode({"client": "web", "lang": "en", "symbol": symbol})
    return symbol, http_json(f"{TV_NEWS_URL}?{query}", timeout=8).get("items", [])


def news(symbols):
    symbols = symbols[:NEWS_SYMBOLS]
    cache_path = STATE_DIR / "news.json"
    cache = load_json(cache_path, {})
    key = ",".join(symbols)
    if cache.get("key") == key and cache.get("at", 0) > time.time() - TV_NEWS_TTL_SEC:
        return cache.get("items", []), ""

    raw, failures = [], 0
    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
        for future in concurrent.futures.as_completed([pool.submit(fetch_headlines, s) for s in symbols]):
            try:
                raw.extend(future.result()[1])
            except (OSError, ValueError):
                failures += 1
    if symbols and failures == len(symbols):
        return cache.get("items", []), "TradingView news unreachable, showing last headlines"

    watched = {s: s.split(":")[-1] for s in symbols}
    items, seen = [], set()
    for item in sorted(raw, key=lambda i: i.get("published", 0), reverse=True):
        if item.get("id") in seen or not item.get("title"):
            continue
        seen.add(item["id"])
        related = [r.get("symbol", "") for r in item.get("relatedSymbols", [])]
        tickers = [watched[s] for s in related if s in watched]
        story = item.get("storyPath")
        items.append({
            "id": item["id"],
            "title": item["title"],
            "source": item.get("source") or item.get("provider", ""),
            "published": item.get("published", 0),
            "urgency": item.get("urgency", 2),
            "symbols": tickers or [r.split(":")[-1] for r in related[:2]],
            "url": safe_url(TV_ORIGIN + story if story and story.startswith("/") else item.get("link")),
        })
        if len(items) >= NEWS_ITEMS:
            break
    save_json(cache_path, {"at": time.time(), "key": key, "items": items})
    return items, ""


# ── Questflow (positions) ────────────────────────────────────────────────────
#
# Positions need a Questflow account. Until Questflow sign-in ships,
# `omatrade login` connects demo accounts and says so, everywhere it shows.

def questflow_status():
    qf = load_state().get("questflow", {})
    return {"connected": bool(qf.get("connected")), "demo": bool(qf.get("demo")),
            "since": qf.get("since")}


def login():
    state = load_state()
    state["questflow"] = {"connected": True, "demo": True, "since": int(time.time())}
    save_state(state)


def logout():
    state = load_state()
    state.pop("questflow", None)
    save_state(state)


def seeded(*parts):
    digest = hashlib.sha256("|".join(map(str, parts)).encode()).hexdigest()
    return random.Random(int(digest[:16], 16))


def drift(base, symbol, now, vol):
    """A price that wanders slowly and repeatably, so two polls a minute apart
    agree and a poll an hour later has moved."""
    minute = int(now // 60)
    rng = seeded(symbol, minute // 5)
    wave = math.sin(minute / 47 + len(symbol)) * vol * 0.6
    return base * (1 + wave + rng.uniform(-vol, vol) * 0.4)


def spark(last, symbol, vol, points=24):
    """The last day, walked backwards from the price we ended on."""
    rng = seeded(symbol, "spark", int(time.time() // 3600))
    series = [last]
    for _ in range(points - 1):
        series.append(series[-1] * (1 + rng.gauss(0, vol / 6)))
    return [round(p, 6) for p in reversed(series)]


STOCKS = [
    # symbol, name, qty, avg, base, vol
    ("NVDA", "NVIDIA", 120, 118.40, 186.20, 0.020),
    ("TSLA", "Tesla", 40, 241.10, 268.70, 0.030),
    ("QQQ", "Invesco QQQ Trust", 25, 471.30, 532.15, 0.008),
    ("COIN", "Coinbase", -30, 312.00, 298.40, 0.035),
]

PERPS = [
    # symbol, qty (negative is short), entry, base, leverage, vol
    ("BTC", 0.85, 98200.0, 112450.0, 5, 0.012),
    ("ETH", -12.0, 3850.0, 3712.0, 3, 0.018),
    ("HYPE", 1500.0, 38.50, 44.90, 3, 0.040),
]

MARKETS = [
    # id, question, outcome, shares, avg, base
    ("fed-dec", "Fed cuts rates in December?", "YES", 2400, 0.54, 0.61),
    ("btc-150k", "BTC above $150k on Dec 31?", "NO", 1800, 0.47, 0.71),
    ("ai-agi", "OpenAI announces AGI in 2026?", "NO", 900, 0.88, 0.93),
]


def demo_accounts(now):
    accounts = []

    rows = []
    for symbol, name, qty, avg, base, vol in STOCKS:
        last = drift(base, symbol, now, vol)
        rows.append(position(
            symbol=symbol, display=symbol, name=name, kind="stock",
            size_label=f"{'Long' if qty > 0 else 'Short'} {abs(qty)} @ {avg:,.2f}",
            avg=avg, last=last, qty=qty, vol=vol))
    accounts.append(account("ibkr", "Interactive Brokers", "U•••4821", rows, cash=18_420.55))

    rows = []
    for symbol, qty, entry, base, lev, vol in PERPS:
        last = drift(base, symbol + "-PERP", now, vol)
        side = "Long" if qty > 0 else "Short"
        rows.append(position(
            symbol=symbol + "-PERP", display=symbol, name=f"{lev}x {side} perp", kind="perp",
            size_label=f"{lev}x {side} {abs(qty):g} @ {entry:,.2f}",
            avg=entry, last=last, qty=qty, vol=vol, margin_divisor=lev))
    accounts.append(account("hyperliquid", "Hyperliquid", "0x7a3…e91c", rows, cash=6_310.00))

    rows = []
    for mid, question, outcome, shares, avg, base in MARKETS:
        last = min(0.99, max(0.01, drift(base, mid, now, 0.03)))
        rows.append(position(
            symbol=mid, display=outcome, name=question, kind="prediction",
            size_label=f"{shares:,} {outcome} @ {avg:.2f}",
            avg=avg, last=last, qty=shares, vol=0.03))
    accounts.append(account("polymarket", "Polymarket", "0x7a3…e91c", rows, cash=1_250.00))

    return accounts


def position(*, symbol, display, name, kind, size_label, avg, last, qty, vol, margin_divisor=1):
    pnl = (last - avg) * qty
    cost = abs(avg * qty) / margin_divisor
    series = spark(last, symbol, vol)
    return {
        "symbol": symbol,
        "display": display,
        "name": name,
        "kind": kind,
        "sizeLabel": size_label,
        "avg": round(avg, 6),
        "last": round(last, 6),
        "value": round(abs(last * qty) / margin_divisor + pnl * (margin_divisor > 1), 2),
        "pnl": round(pnl, 2),
        "pnlPct": round(pnl / cost * 100, 2) if cost else 0.0,
        "dayChangePct": round((last / series[0] - 1) * 100 * (1 if qty > 0 else -1), 2),
        "spark": series,
    }


def account(aid, name, label, positions, cash):
    equity = cash + sum(p["value"] for p in positions)
    day = sum(p["value"] * p["dayChangePct"] / 100 for p in positions)
    return {
        "id": aid,
        "name": name,
        "label": label,
        "equity": round(equity, 2),
        "dayPnl": round(day, 2),
        "dayPnlPct": round(day / max(1, equity - day) * 100, 2),
        "positions": positions,
    }


def totals(accounts):
    equity = sum(a["equity"] for a in accounts)
    day = sum(a["dayPnl"] for a in accounts)
    return {
        "equity": round(equity, 2),
        "dayPnl": round(day, 2),
        "dayPnlPct": round(day / max(1, equity - day) * 100, 2),
        "openPnl": round(sum(p["pnl"] for a in accounts for p in a["positions"]), 2),
        "positions": sum(len(a["positions"]) for a in accounts),
    }


# ── Theme ────────────────────────────────────────────────────────────────────

def hex_rgb(value):
    v = value.strip().lstrip("#")[:6]
    return tuple(int(v[i:i + 2], 16) for i in (0, 2, 4))


def rgb_hex(rgb):
    return "#" + "".join(f"{max(0, min(255, round(c))):02x}" for c in rgb)


def mix(a, b, t):
    ra, rb = hex_rgb(a), hex_rgb(b)
    return rgb_hex(tuple(x + (y - x) * t for x, y in zip(ra, rb)))


def luminance(value):
    def channel(c):
        c /= 255
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = (channel(c) for c in hex_rgb(value))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def contrast(a, b):
    la, lb = sorted((luminance(a), luminance(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def legible(color, ground, toward, minimum):
    """Nudge a colour toward `toward` until it reads on `ground`."""
    out = color
    for step in range(1, 11):
        if contrast(out, ground) >= minimum:
            return out
        out = mix(color, toward, step / 10)
    return out


def theme_colors():
    raw = {}
    try:
        raw = tomllib.loads((THEME_DIR / "colors.toml").read_text())
    except (OSError, tomllib.TOMLDecodeError):
        pass
    pick = lambda *keys, default: next((raw[k] for k in keys if isinstance(raw.get(k), str)), default)

    bg = pick("background", "color0", default="#101315")
    fg = pick("foreground", "color7", default="#cacccc")
    up = legible(pick("green", "color2", default="#62b36c"), bg, fg, 3.0)
    down = legible(pick("red", "color1", default="#d35d5d"), bg, fg, 3.0)
    accent = legible(pick("accent", "blue", "color4", default=fg), bg, fg, 3.0)
    muted = legible(mix(fg, bg, 0.42), bg, fg, 3.0)

    def tag(fill):
        label = bg if contrast(bg, fill) >= contrast(fg, fill) else fg
        return {"fill": fill, "label": label}

    return {
        "text": fg,
        "muted": muted,
        "up": up,
        "down": down,
        "flat": muted,
        "accent": accent,
        "hover": mix(bg, fg, 0.08),
        "rule": mix(bg, fg, 0.14),
        "tags": {"up": tag(up), "down": tag(down), "flat": tag(mix(bg, fg, 0.18)), "accent": tag(accent)},
    }


# ── Summary ──────────────────────────────────────────────────────────────────

def summary(now, notify=False):
    watchlist = tradingview_watchlist()
    items, news_error = news(tv_symbols())

    state = load_state()
    ids = [i["id"] for i in items]
    # First run: what is already on the feed is history, not news.
    seen = set(state.get("seenNews", ids))
    if notify:
        for item in reversed(items):
            if item["id"] not in seen and item["urgency"] <= NEWS_NOTIFY_URGENCY:
                send_notification(item)
    seen.update(ids)
    state["seenNews"] = [i for i in ids if i in seen] + [i for i in state.get("seenNews", []) if i not in ids][:200]
    save_state(state)

    qf = questflow_status()
    accounts = demo_accounts(now) if qf["connected"] else []
    return {
        "updatedAt": int(now * 1000),
        "colors": theme_colors(),
        "questflow": qf,
        "mock": qf["connected"] and qf["demo"],
        "totals": totals(accounts) if accounts else None,
        "accounts": accounts,
        "watchlist": watchlist,
        "news": {"items": items, "error": news_error},
    }


# ── Desktop ──────────────────────────────────────────────────────────────────

def send_notification(item):
    if not shutil.which("notify-send"):
        return
    title = (" · ".join(item["symbols"][:3]) + "  " if item["symbols"] else "") + item["source"]
    cmd = ["notify-send", "--app-name=Omatrade", "--urgency=normal",
           "--action=open=Read on TradingView", "--wait"]
    if ICON.exists():
        cmd.append(f"--icon={ICON}")
    cmd += [title, item["title"]]
    # Detached: --wait holds the process until the notification is clicked or
    # dismissed, and the bar poll that sent it must not wait with it.
    script = 'choice=$("$@"); [ "$choice" = open ] && xdg-open "$OMATRADE_URL" >/dev/null 2>&1'
    env = dict(os.environ, OMATRADE_URL=safe_url(item["url"]))
    subprocess.Popen(["sh", "-c", script, "notify"] + cmd, env=env,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def poke_bar():
    if not shutil.which("omarchy-shell"):
        return
    try:
        subprocess.run(["omarchy-shell", "-q", PLUGIN_ID, "refresh"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
    except (OSError, subprocess.SubprocessError):
        pass


def open_url(url):
    subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


# ── Text output ──────────────────────────────────────────────────────────────

def fmt_price(v):
    if v is None:
        return "–"
    a = abs(v)
    return f"{v:,.2f}" if a >= 1 else f"{v:.4f}" if a >= 0.01 else f"{v:.6f}"


def fmt_money(v, signed=False):
    sign = "+" if signed and v > 0 else "-" if v < 0 else ""
    return f"{sign}${abs(v):,.2f}"


def fmt_pct(v):
    return f"{'+' if v > 0 else ''}{v:.2f}%"


def ago(ts, now):
    s = max(0, int(now - ts))
    if s < 60:
        return "now"
    if s < 3600:
        return f"{s // 60}m"
    if s < 86400:
        return f"{s // 3600}h"
    return f"{s // 86400}d"


def print_watchlist(wl):
    if wl["source"] == "starter":
        print("Starter list — add yours: omatrade tv add NASDAQ:AAPL, or omatrade tv import\n")
    if wl["error"]:
        print(wl["error"] + "\n")
    for sec in wl["sections"]:
        if sec["name"]:
            print(sec["name"].upper())
        for e in sec["entries"]:
            if not e["found"]:
                print(f"  {e['symbol']:<22} not found on TradingView")
                continue
            print(f"  {e['symbol']:<22} {e['name'][:30]:<30} {fmt_price(e['last']):>12} "
                  f"{fmt_pct(e['changePct'] or 0):>8}")
        print()


def print_news(feed):
    now = time.time()
    if feed["error"]:
        print(feed["error"] + "\n")
    for item in feed["items"]:
        mark = "!" if item["urgency"] <= NEWS_NOTIFY_URGENCY else " "
        tickers = ",".join(item["symbols"][:3])
        print(f"{mark} {ago(item['published'], now):>4}  {tickers:<14} {item['title'][:90]}  — {item['source']}")


def print_positions(data):
    if not data["questflow"]["connected"]:
        print("Not connected to Questflow. Connect: omatrade login")
        return
    t = data["totals"]
    print(f"Equity {fmt_money(t['equity'])}   day {fmt_money(t['dayPnl'], True)} ({fmt_pct(t['dayPnlPct'])})"
          f"   open P&L {fmt_money(t['openPnl'], True)}   [demo accounts]")
    for a in data["accounts"]:
        print(f"\n{a['name'].upper()}  {a['label']}  {fmt_money(a['equity'])}  {fmt_pct(a['dayPnlPct'])}")
        for p in a["positions"]:
            label = p["display"] if p["kind"] != "prediction" else f"{p['display']} · {p['name']}"
            print(f"  {label[:38]:<38} {p['sizeLabel']:<26} {fmt_price(p['last']):>12} "
                  f"{fmt_money(p['pnl'], True):>13} {fmt_pct(p['pnlPct']):>9}")


# ── CLI ──────────────────────────────────────────────────────────────────────

def main(argv=None):
    parser = argparse.ArgumentParser(
        prog=APP, description="Questflow on the desktop: TradingView watchlist, trading news, positions.")
    sub = parser.add_subparsers(dest="cmd")

    p = sub.add_parser("summary", help="everything the bar shows")
    p.add_argument("--json", action="store_true")
    p.add_argument("--notify", action="store_true", help="notify on breaking news for the watchlist")
    for name, help_text in (("news", "trading news for the watchlist"),
                            ("positions", "positions across Questflow-connected accounts")):
        sp = sub.add_parser(name, help=help_text)
        sp.add_argument("--json", action="store_true")
    sub.add_parser("login", help="connect Questflow (demo accounts until OAuth ships)")
    sub.add_parser("logout", help="disconnect Questflow")
    op = sub.add_parser("open", help="open a URL, or Questflow, in the browser")
    op.add_argument("target", nargs="?", default="")

    tv = sub.add_parser("tv", help="TradingView watchlist")
    tv.add_argument("--json", action="store_true")
    tv_sub = tv.add_subparsers(dest="tv_cmd")
    ts = tv_sub.add_parser("search", help="find symbols on TradingView")
    ts.add_argument("text")
    ts.add_argument("--json", action="store_true")
    ti = tv_sub.add_parser("import", help="import a TradingView export (default: newest in ~/Downloads)")
    ti.add_argument("file", nargs="?")
    ta = tv_sub.add_parser("add", help="add EXCHANGE:SYMBOL")
    ta.add_argument("symbol")
    ta.add_argument("--section")
    tr = tv_sub.add_parser("remove", help="remove a symbol")
    tr.add_argument("symbol")
    tm = tv_sub.add_parser("move", help="reorder: move a symbol before/after another, or to a section's top")
    tm.add_argument("symbol")
    where = tm.add_mutually_exclusive_group(required=True)
    where.add_argument("--before")
    where.add_argument("--after")
    where.add_argument("--section")
    to = tv_sub.add_parser("open", help="open a symbol's chart on TradingView")
    to.add_argument("symbol")

    args = parser.parse_args(argv)
    cmd = args.cmd or "tv"

    if cmd == "tv":
        return tv_main(args)
    if cmd == "login":
        login()
        poke_bar()
        print("Questflow sign-in is not live yet — connected demo accounts instead.")
        return 0
    if cmd == "logout":
        logout()
        poke_bar()
        print("Disconnected from Questflow.")
        return 0
    if cmd == "open":
        target = args.target
        open_url(target if safe_url(target) == target else
                 QUESTFLOW_URL + (f"/?q={urllib.parse.quote(target)}" if target else ""))
        return 0

    data = summary(time.time(), notify=getattr(args, "notify", False))
    if getattr(args, "json", False):
        if cmd == "news":
            data = data["news"]
        elif cmd == "positions":
            data = {k: data[k] for k in ("questflow", "mock", "totals", "accounts")}
        json.dump(data, sys.stdout, separators=(",", ":"))
        print()
    elif cmd == "news":
        print_news(data["news"])
    elif cmd == "positions":
        print_positions(data)
    else:
        print_watchlist(data["watchlist"])
        print_news(data["news"])
        print()
        print_positions(data)
    return 0


def tv_main(args):
    tv_cmd = getattr(args, "tv_cmd", None)
    if tv_cmd == "open":
        open_url(tv_url(args.symbol.upper()))
        return 0
    if tv_cmd == "search":
        try:
            results = tv_search(args.text)
        except (OSError, ValueError) as e:
            if args.json:
                json.dump({"results": [], "error": f"search failed ({reason(e)})"}, sys.stdout)
                print()
                return 0
            raise SystemExit(f"search failed ({reason(e)})")
        if args.json:
            json.dump({"results": results, "error": ""}, sys.stdout, separators=(",", ":"))
            print()
        else:
            for r in results:
                print(f"{r['symbol']:<24} {r['type']:<10} {r['name']}")
        return 0
    if tv_cmd == "import":
        source, sections = tv_import(args.file)
        poke_bar()
        count = sum(len(sec["symbols"]) for sec in sections)
        print(f"imported {count} symbols in {len(sections)} sections from {source}")
        return 0
    if tv_cmd in ("add", "remove", "move"):
        if tv_cmd == "add":
            tv_add(args.symbol, section=args.section)
        elif tv_cmd == "move":
            tv_move(args.symbol, before=args.before, after=args.after, section=args.section)
        else:
            tv_remove(args.symbol)
        poke_bar()
    wl = tradingview_watchlist()
    if getattr(args, "json", False):
        json.dump(wl, sys.stdout, separators=(",", ":"))
        print()
    else:
        print_watchlist(wl)
    return 0


if __name__ == "__main__":
    sys.exit(main())
